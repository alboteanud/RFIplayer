<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:showIn="@layout/activity_main"
        tools:context=".MainActivity">

    <TextView
            android:id="@+id/statusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60dp"
            android:text="_"
            app:layout_constraintBottom_toTopOf="@+id/buttonPlay48"
            app:layout_constraintEnd_toEndOf="@+id/buttonPlay48"
            app:layout_constraintStart_toStartOf="@+id/buttonPlay48" />


    <Button
            android:id="@+id/buttonPlay48"
            android:layout_height="wrap_content"
            android:layout_width="200dp"
            android:layout_marginBottom="60dp"
            android:minHeight="60dp"
            android:onClick="onClick"
            android:text="48 kbps"
            app:layout_constraintBottom_toTopOf="@+id/buttonPlay128"
            app:layout_constraintEnd_toEndOf="@+id/buttonPlay128"
            app:layout_constraintStart_toStartOf="@+id/buttonPlay128" />

    <Button
            android:id="@+id/buttonPlay128"
            android:layout_height="wrap_content"
            android:layout_width="200dp"
            android:layout_marginBottom="60dp"
            android:minHeight="60dp"
            android:onClick="onClick"
            android:text="128 kbps"
            app:layout_constraintBottom_toTopOf="@+id/buttonStop"
            app:layout_constraintEnd_toEndOf="@+id/buttonStop"
            app:layout_constraintStart_toStartOf="@+id/buttonStop" />

    <Button
            android:id="@+id/buttonStop"
            android:layout_height="wrap_content"
            android:layout_width="200dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="60dp"
            android:minHeight="60dp"
            android:onClick="onClick"
            android:text="Stop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>